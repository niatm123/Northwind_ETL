                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    od.OrderID,
    ROW_NUMBER() OVER (PARTITION BY od.OrderID ORDER BY od.ProductID) AS OrderLineNumber,
    o.CustomerID,
    od.ProductID,
    CONVERT(INT, FORMAT(o.OrderDate, 'yyyyMMdd')) AS DateKey,
    od.Quantity,
    od.UnitPrice,
    od.Discount,
    CAST(od.Quantity * od.UnitPrice AS decimal(18,2)) AS GrossAmount,
    CAST(od.Quantity * od.UnitPrice * (1 - od.Discount) AS decimal(18,2)) AS NetAmount,
    CAST(GETDATE() AS datetime2(0)) AS LoadedAtUtc
FROM dbo.[Order Details] od
INNER JOIN dbo.Orders o
    ON od.OrderID = o.OrderID;</property>
