    <DTS:Executable
      DTS:refId="Package\Load DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9EDC106D-E070-4598-BBF6-1C04A1FB2F38}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{561A9FE1-7532-448A-9FA8-A0C431FA8D40}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SET LANGUAGE English;&#xA;&#xA;;WITH Dates AS&#xA;(&#xA;    SELECT CAST('2020-01-01' AS date) AS FullDate&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, FullDate)&#xA;    FROM Dates&#xA;    WHERE FullDate &lt; '2030-12-31'&#xA;)&#xA;INSERT INTO dbo.DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    [Year],&#xA;    [Quarter],&#xA;    [Month],&#xA;    MonthName,&#xA;    [Week],&#xA;    DayOfMonth,&#xA;    DayName&#xA;)&#xA;SELECT&#xA;    CONVERT(int, CONVERT(char(8), FullDate, 112)) AS DateKey,&#xA;    FullDate,&#xA;    YEAR(FullDate) AS [Year],&#xA;    DATEPART(QUARTER, FullDate) AS [Quarter],&#xA;    MONTH(FullDate) AS [Month],&#xA;    DATENAME(MONTH, FullDate) AS MonthName,&#xA;    DATEPART(WEEK, FullDate) AS [Week],&#xA;    DAY(FullDate) AS DayOfMonth,&#xA;    DATENAME(WEEKDAY, FullDate) AS DayName&#xA;FROM Dates&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimDate d&#xA;    WHERE d.DateKey =&#xA;          CONVERT(int, CONVERT(char(8), Dates.FullDate, 112))&#xA;)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
