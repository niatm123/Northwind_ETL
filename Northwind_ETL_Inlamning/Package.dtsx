                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.ProductID,
    p.ProductName,
    c.CategoryName,
    p.UnitPrice,
    p.Discontinued,
    CAST(GETDATE() AS datetime2(0)) AS EffectiveFromUtc,
    TRY_CONVERT(decimal(10,2), e.CostPrice) AS CostPrice,
    e.CountryOfOrigin,
    e.SupplierProductCode
FROM Northwind.dbo.Products p
LEFT JOIN Northwind.dbo.Categories c
    ON p.CategoryID = c.CategoryID
LEFT JOIN NorthwindDW.dbo.ProductCatalog_Extra e
    ON p.ProductID = e.ProductID;</property>
